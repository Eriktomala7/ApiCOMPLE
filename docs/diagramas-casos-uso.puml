@startuml
title Sistema de gestión de inventario - Casos de uso generales
left to right direction

actor "Usuario" as Usuario
actor "Administrador" as Admin
actor "Servicio de correo" as Correo
actor "Cloudinary" as Cloudinary
actor "Google Gemini" as Gemini

Admin --|> Usuario

rectangle "Sistema de gestion de inventario" {
  usecase "Iniciar sesión" as UC_Login
  usecase "Registrarse" as UC_Register
  usecase "Recuperar contraseña" as UC_Recovery
  usecase "Consultar productos y categorías" as UC_Browse
  usecase "Gestionar perfil" as UC_Profile
  usecase "Solicitar productos" as UC_Request
  usecase "Consultar estado de solicitudes" as UC_RequestStatus
  usecase "Gestionar usuarios" as UC_Users
  usecase "Gestionar categorias" as UC_Categories
  usecase "Gestionar productos" as UC_Products
  usecase "Crear producto" as UC_CreateProduct
  usecase "Validar producto con IA" as UC_AI
  usecase "Gestionar movimientos de inventario" as UC_Movements
  usecase "Revisar solicitudes" as UC_Review
  usecase "Consultar panel y alertas" as UC_Dashboard
  usecase "Generar reportes" as UC_Reports
  usecase "Enviar notificaciones por correo" as UC_Email
  usecase "Administrar imagenes" as UC_Images
}

Usuario -- UC_Login
Usuario -- UC_Register
Usuario -- UC_Recovery
Usuario -- UC_Browse
Usuario -- UC_Profile
Usuario -- UC_Request
Usuario -- UC_RequestStatus
Admin -- UC_Users
Admin -- UC_Categories
Admin -- UC_Products
Admin -- UC_CreateProduct
Admin -- UC_Movements
Admin -- UC_Review
Admin -- UC_Dashboard
Admin -- UC_Reports
Admin -- UC_Images

UC_CreateProduct .> UC_AI : <<include>>
UC_Recovery .> UC_Email : <<include>>
UC_Request .> UC_Email : <<include>>
UC_Review .> UC_Email : <<include>>
UC_Movements .> UC_Email : <<extend>>
UC_Email -- Correo
UC_Images -- Cloudinary
UC_AI -- Gemini
@enduml

