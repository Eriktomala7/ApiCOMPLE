Admin -- UC_Movement
Admin -- UC_MovementList
Admin -- UC_Requests
Admin -- UC_Dashboard
Admin -- UC_InventoryReport
Admin -- UC_MovementReport
Admin -- UC_StockReport

UC_CreateProduct .> UC_AI : <<include>>
