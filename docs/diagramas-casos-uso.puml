@startuml
title Sistema de gestión de inventario - Casos de uso del usuario y solicitudes
left to right direction

actor "Usuario" as Usuario
actor "Administrador" as Admin
actor "Servicio de correo" as Correo
actor "Cloudinary" as Cloudinary

Admin --|> Usuario

rectangle "Acceso, consulta y solicitudes" {
  usecase "Registrarse" as UC_Register
  usecase "Iniciar sesión" as UC_Login
  usecase "Solicitar recuperación de contraseña" as UC_Recovery
  usecase "Restablecer contraseña con token" as UC_Reset
  usecase "Consultar productos y categorías" as UC_Browse
  usecase "Consultar perfil" as UC_Profile
  usecase "Actualizar datos o foto de perfil" as UC_EditProfile
  usecase "Crear solicitud de producto" as UC_CreateRequest
  usecase "Consultar solicitudes propias" as UC_MyRequests
  usecase "Consultar resultado de solicitud" as UC_RequestResult
  usecase "Revisar solicitudes pendientes" as UC_Review
  usecase "Aprobar o rechazar solicitud" as UC_Resolve
}

Usuario -- UC_Register
Usuario -- UC_Login
Usuario -- UC_Recovery
Usuario -- UC_Reset
Usuario -- UC_Browse
Usuario -- UC_Profile
Usuario -- UC_EditProfile
Usuario -- UC_CreateRequest
Usuario -- UC_MyRequests
Usuario -- UC_RequestResult
Admin -- UC_Review
Admin -- UC_Resolve

UC_Recovery .> UC_Reset : <<include>>
UC_Recovery -- Correo
UC_CreateRequest -- Correo : avisa al administrador
UC_Resolve -- Correo : informa el resultado
UC_EditProfile -- Cloudinary
@enduml
